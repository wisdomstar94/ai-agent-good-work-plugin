{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}\"; [ -n \"$ROOT\" ] || exit 0; sh \"$ROOT/hooks/session-start.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
